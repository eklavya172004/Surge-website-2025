# Environment Variables Template

# Neon Database URL
# For development: a development-specific database
# For production: the production database
DATABASE_URL="your-neon-db-connection-string-here"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000" # Change to your production URL in production
NEXTAUTH_SECRET="your-secret-key-here"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key-here"
EMAIL_FROM="your-verified-sender@example.com"

# Add other environment variables as needed